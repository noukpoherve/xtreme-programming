                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path",
            "description": "URL path that produced the error."
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
